# Rust build output
/target
**/*.rs.bk

# Lambda build artifacts
/dist

# Terraform (the provider lock file .terraform.lock.hcl IS committed for reproducible CI)
infra/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Local env / secrets
.env
.env.local
*.pem

# Accessibility test (axe via Playwright) — deps + downloaded browsers are installed in CI; only
# the source + lockfile are committed.
tests/a11y/node_modules/
tests/a11y/test-results/
tests/a11y/playwright-report/

# URN parse-conformance test — the dig-sdk dependency carrying the contract table is installed
# in CI; only the source + lockfile are committed.
tests/conformance/node_modules/
# Code-intelligence index (gitnexus): regenerable, per-worktree, never committed.
.gitnexus/
